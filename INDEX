        function loadRegistryFromLocal() {
            try {
                const raw = localStorage.getItem(window.LOCAL_STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (parsed && parsed.profiles) {
                        window.registryState = {
                            adminSecret: parsed.adminSecret || "ADMIN-2026",
                            issuedKeys: parsed.issuedKeys || {},
                            activeProfileId: parsed.activeProfileId || null,
                            profiles: parsed.profiles
                        };
                    }
                }
            } catch (e) {}

            renderGateExistingProfiles();

            if (window.registryState.activeProfileId && window.registryState.profiles[window.registryState.activeProfileId]) {
                window.appState = window.registryState.profiles[window.registryState.activeProfileId];
                document.getElementById("access-gate-overlay").classList.add("hidden");
                updateHeaderProfileDisplay();
            } else {
                document.getElementById("access-gate-overlay").classList.remove("hidden");
                switchGateAuthTab("member");
            }
        }

        function saveStateToLocal() {
            if (!window.appState) return;
            window.appState.updatedAt = Date.now();
            window.registryState.profiles[window.appState.activeMemberId] = window.appState;
            window.registryState.activeProfileId = window.appState.activeMemberId;
            try {
                localStorage.setItem(window.LOCAL_STORAGE_KEY, JSON.stringify(window.registryState));
            } catch (e) {}
            saveRegistryToIndexedDB(window.registryState);
            if (typeof window.pushStateToFirebase === "function") {
                window.pushStateToFirebase(false);
            }
            if (typeof window.pushMemberStatsToLeaderboard === "function") {
                window.pushMemberStatsToLeaderboard();
            }
        }

        function saveRegistryToIndexedDB(data) {
            try {
                const req = indexedDB.open("DailySpeak365_DB", 1);
                req.onupgradeneeded = (e) => {
                    const idb = e.target.result;
                    if (!idb.objectStoreNames.contains("registry")) {
                        idb.createObjectStore("registry");
                    }
                };
                req.onsuccess = (e) => {
                    const idb = e.target.result;
                    const tx = idb.transaction("registry", "readwrite");
                    tx.objectStore("registry").put(data, "master_state");
                };
            } catch (e) {}
        }

