        function evaluateProgressionGates() {
            const activeErrors = window.appState.errorNotebook.filter(e => e.status === "Active");
            const groupCounts = {};
            activeErrors.forEach(err => {
                const key = `${err.skill}::${err.errorCategory}`;
                groupCounts[key] = (groupCounts[key] || 0) + 1;
            });

            Object.entries(groupCounts).forEach(([key, count]) => {
                if (count >= 5) {
                    const [skill, errorCategory] = key.split("::");
                    const exists = window.appState.progressionGates.find(g => g.skill === skill && g.errorCategory === errorCategory && g.status === "Gated");
                    if (!exists) {
                        window.appState.progressionGates.push({
                            gateId: `GATE-${Date.now()}`,
                            skill,
                            errorCategory,
                            reason: `Có ${count} lỗi độc lập nhóm ${skill} × ${errorCategory}`,
                            status: "Gated",
                            history: []
                        });
                    }
                }
            });
        }

        function isProgressionGated() {
            return window.appState.progressionGates.some(g => g.status === "Gated");
        }

