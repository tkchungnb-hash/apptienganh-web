<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#4338ca">
    <title>DailySpeak & Master 365 — v5.0</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- QRCode.js for Multi-Device Pairing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- PDF.js for Multi-page PDF Extraction & Canvas Scan Rendering -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        if (window.pdfjsLib) {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
    </script>
    <!-- Mammoth.js for Word (.docx) Client-side Extraction -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
    <!-- Tesseract.js for Image & Scanned-PDF OCR -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            200: '#c7d2fe',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #cbd5e1;
            -webkit-tap-highlight-color: transparent;
            overscroll-behavior-y: none;
        }
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d {
            transform-style: preserve-3d;
            transition: transform 0.55s cubic-bezier(0.34, 1.25, 0.64, 1);
        }
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .rotate-y-180 { transform: rotateY(180deg); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        @keyframes pulseMic {
            0% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.65); }
            70% { box-shadow: 0 0 0 12px rgba(225, 29, 72, 0); }
            100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); }
        }
        .mic-active {
            animation: pulseMic 1.4s infinite;
            background-color: #e11d48 !important;
            color: #ffffff !important;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-slide-up { animation: slideUp 0.25s ease-out forwards; }
    </style>
</head>
<body class="text-slate-800 antialiased flex justify-center min-h-screen">

    <!-- Responsive Mobile-First App Shell -->
    <div class="w-full max-w-lg bg-slate-50 min-h-screen shadow-2xl relative flex flex-col justify-between overflow-x-hidden border-x border-slate-200">

        <!-- ==================== TOP STICKY HEADER ==================== -->
        <header class="bg-white px-4 pt-3 pb-2.5 border-b border-slate-200/90 sticky top-0 z-30">
            <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-600 to-indigo-900 text-white flex flex-col items-center justify-center font-extrabold shadow-xs leading-none shrink-0">
                        <span class="text-[11px]">348</span>
                        <span class="text-[8px] text-brand-200 uppercase">Phiên</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <h1 class="font-extrabold text-sm text-slate-900 tracking-tight">DailySpeak & Master</h1>
                            <span class="px-1.5 py-0.5 rounded bg-brand-50 text-brand-700 text-[9px] font-extrabold border border-brand-200">v5.1</span>
                        </div>
                        <p id="header-session-subtitle" class="text-[11px] font-semibold text-slate-500">
                            Phiên 1/348 • Chu kỳ 1 (Tuần 1)
                        </p>
                    </div>
                </div>

                <!-- Profile/Group Manager, Multi-Device Sync & Skip Today Action -->
                <div class="flex items-center gap-1">
                    <button type="button" onclick="openProfileGroupModal()" id="profile-header-btn" class="flex items-center gap-1 px-2 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 text-indigo-800 text-[11px] font-extrabold transition active:scale-95" title="Quản lý Hồ sơ Tên & Bảng Xếp Hạng Nhóm">
                        <i data-lucide="user-check" class="w-3.5 h-3.5 text-indigo-600"></i>
                        <span id="header-active-username" class="max-w-[68px] truncate">Học viên</span>
                    </button>
                    <button type="button" onclick="openSyncModal()" id="sync-header-btn" class="flex items-center gap-1 px-2 py-1.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-700 text-[11px] font-extrabold transition active:scale-95" title="Mã Liên Kết & QR Đa Thiết Bị">
                        <span id="sync-status-dot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
                        <span id="sync-code-short">Sync</span>
                        <i data-lucide="qr-code" class="w-3.5 h-3.5"></i>
                    </button>
                    <button type="button" onclick="confirmSkipToday()" class="px-2 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-800 text-[11px] font-extrabold transition active:scale-95" title="Ghi nhận ngày nghỉ hôm nay, giữ nguyên phiên học hiện tại">
                        Báo bận
                    </button>
                </div>
            </div>

            <!-- ProgressionGate Alert Banner (Shown only when Gated) -->
            <div id="progression-gate-banner" class="hidden mb-2 p-2.5 rounded-2xl bg-rose-50 border border-rose-200 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 text-xs text-rose-800">
                    <i data-lucide="lock" class="w-4 h-4 text-rose-600 shrink-0"></i>
                    <div>
                        <span class="font-extrabold block text-[11px]">Cổng tiến độ đang khóa (ProgressionGate)</span>
                        <span id="gate-reason-text" class="text-[10px] text-rose-700">Cần hoàn thành bài củng cố nhóm lỗi yếu (≥ 4/5 câu)</span>
                    </div>
                </div>
                <button type="button" onclick="switchTab('errors')" class="px-2.5 py-1.5 rounded-xl bg-rose-600 text-white text-[10px] font-extrabold shrink-0">
                    Mở khóa
                </button>
            </div>

            <!-- Adaptive Load & Session Progress Bar -->
            <div class="space-y-1">
                <div class="flex justify-between items-center text-[10px] font-bold">
                    <span class="text-slate-500">
                        Tải phiên: <strong id="session-load-label" class="text-slate-800">6 từ</strong>
                        <span id="adaptive-mode-tag" class="ml-1 px-1.5 py-0.2 rounded bg-slate-100 text-slate-600">Tiêu chuẩn</span>
                    </span>
                    <span id="session-mastery-label" class="text-brand-600 font-extrabold">0/6 Mastered (2 cấp)</span>
                </div>
                <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                    <div id="session-progress-bar" class="h-full bg-gradient-to-r from-brand-600 to-emerald-500 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
            </div>
        </header>

        <!-- ==================== MAIN SCROLLABLE WORKSPACE ==================== -->
        <main class="flex-1 px-4 py-3.5 pb-24 overflow-y-auto no-scrollbar">

            <!-- =================================================================== -->
            <!-- TAB 1: PHIÊN HỌC HIỆN TẠI (CURRICULUM SESSION & 2-LEVEL MASTERY)    -->
            <!-- =================================================================== -->
            <section id="tab-session" class="space-y-3.5 animate-slide-up">

                <!-- Session Selector & Calendar Record Strip -->
                <div class="bg-white rounded-2xl p-2.5 border border-slate-200/80 shadow-xs flex items-center justify-between gap-2">
                    <button type="button" onclick="navigateSession(-1)" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center active:scale-90 transition">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                    </button>

                    <div class="text-center flex-1">
                        <div class="flex items-center justify-center gap-1.5">
                            <span id="session-type-badge" class="px-2 py-0.5 rounded-md bg-brand-50 text-brand-700 text-[10px] font-extrabold border border-brand-200">Daily Knowledge</span>
                            <span id="session-status-pill" class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 text-[10px] font-extrabold">Available</span>
                        </div>
                        <p id="calendar-today-info" class="text-[10px] text-slate-400 font-medium mt-0.5">
                            Hôm nay: 16/11/2026 • Đã học 0 phiên thực tế
                        </p>
                    </div>

                    <button type="button" onclick="navigateSession(1)" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center active:scale-90 transition">
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </button>
                </div>

                <!-- Sub-Mode Switcher inside Current Session -->
                <div class="grid grid-cols-3 gap-1 bg-slate-200/80 p-1 rounded-2xl text-[11px] font-extrabold">
                    <button type="button" onclick="setSessionSubView('cards')" id="ssub-cards" class="py-2 px-1 rounded-xl bg-white text-brand-600 shadow-xs transition">
                        1. Thẻ Từ (6 từ)
                    </button>
                    <button type="button" onclick="setSessionSubView('mastery')" id="ssub-mastery" class="py-2 px-1 rounded-xl text-slate-600 transition">
                        2. Kiểm Tra 2 Cấp
                    </button>
                    <button type="button" onclick="setSessionSubView('grammar')" id="ssub-grammar" class="py-2 px-1 rounded-xl text-slate-600 transition">
                        3. Ngữ Pháp & Câu
                    </button>
                </div>

                <!-- SUB-VIEW 1A: FLASHCARDS WITH REFERENCE-ONLY EXPANSION -->
                <div id="session-view-cards" class="space-y-3">
                    <!-- Word Dots -->
                    <div id="word-dots-container" class="flex justify-center gap-1.5"></div>

                    <!-- 3D Flip Card -->
                    <div class="perspective-1000 w-full h-[460px] cursor-pointer select-none" onclick="flipCard()">
                        <div id="card-3d-inner" class="relative w-full h-full transform-style-3d">

                            <!-- CARD FRONT -->
                            <div class="absolute inset-0 backface-hidden bg-white rounded-3xl shadow-md border border-slate-200/90 p-5 flex flex-col justify-between">
                                <div class="flex items-center justify-between gap-1.5">
                                    <span id="card-domain-badge" class="px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-sky-100 text-sky-700">
                                        Logistics & XNK
                                    </span>
                                    <span id="card-mastery-badge" class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-slate-100 text-slate-600">
                                        Chưa đạt Cấp 1
                                    </span>
                                    <span id="card-counter-text" class="text-xs font-bold text-slate-400">1/6</span>
                                </div>

                                <div class="my-auto text-center space-y-3 px-1">
                                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-slate-100 text-slate-600 text-xs font-bold">
                                        <span id="card-pos">(n)</span>
                                        <span>•</span>
                                        <span id="card-ipa" class="font-mono text-brand-600">/kənˌsaɪˈniː/</span>
                                    </div>

                                    <h2 id="card-headword" class="text-3xl font-extrabold text-slate-900 tracking-tight break-words leading-tight">
                                        Consignee
                                    </h2>

                                    <!-- US / UK Web Speech Audio Controls -->
                                    <div class="pt-2 flex items-center justify-center gap-2">
                                        <button type="button" onclick="event.stopPropagation(); speakWord(currentWordObj().headword, 'en-US', 0.95)" class="flex items-center gap-1.5 px-3.5 py-2.5 rounded-2xl bg-brand-50 hover:bg-brand-100 text-brand-700 font-bold text-xs border border-brand-200 active:scale-95 transition">
                                            <i data-lucide="volume-2" class="w-4 h-4"></i>
                                            <span>Giọng Mỹ (US)</span>
                                        </button>
                                        <button type="button" onclick="event.stopPropagation(); speakWord(currentWordObj().headword, 'en-GB', 0.95)" class="flex items-center gap-1.5 px-3.5 py-2.5 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs active:scale-95 transition">
                                            <i data-lucide="volume-2" class="w-4 h-4"></i>
                                            <span>Giọng Anh (UK)</span>
                                        </button>
                                    </div>

                                    <div id="card-srs-info-pill" class="inline-block px-3 py-1 rounded-xl bg-indigo-50/70 text-indigo-700 text-[11px] font-semibold">
                                        Lịch SRS: Từ mới phiên này
                                    </div>
                                </div>

                                <div class="text-center text-[11px] text-slate-400 font-medium flex items-center justify-center gap-1.5">
                                    <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
                                    <span>Chạm thẻ để xem đa nghĩa chuyên ngành & khung Tham khảo mở rộng</span>
                                </div>
                            </div>

                            <!-- CARD BACK -->
                            <div class="absolute inset-0 backface-hidden rotate-y-180 bg-white rounded-3xl shadow-md border-2 border-brand-200 p-4 flex flex-col justify-between overflow-hidden">
                                <div class="flex items-center justify-between border-b border-slate-100 pb-2 shrink-0">
                                    <div>
                                        <div class="flex items-center gap-1.5">
                                            <h3 id="card-headword-back" class="text-base font-extrabold text-slate-900">Consignee</h3>
                                            <span id="card-pos-back" class="text-xs font-bold text-brand-600">(n)</span>
                                        </div>
                                        <span id="card-ipa-back" class="text-[11px] font-mono text-slate-400">/kənˌsaɪˈniː/</span>
                                    </div>
                                    <button type="button" onclick="event.stopPropagation(); speakWord(currentWordObj().headword, 'en-US', 0.95)" class="w-8 h-8 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center">
                                        <i data-lucide="volume-2" class="w-4 h-4"></i>
                                    </button>
                                </div>

                                <div class="my-auto space-y-2.5 py-2 overflow-y-auto no-scrollbar">
                                    <!-- Core Meaning & Domain Contexts -->
                                    <div class="bg-brand-50/80 p-2.5 rounded-2xl border border-brand-100 space-y-1">
                                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-brand-600 block">Nghĩa chính & Ngữ cảnh chuyên ngành</span>
                                        <p id="card-core-meaning" class="text-sm font-extrabold text-slate-900 leading-snug"></p>
                                        <div id="card-domain-contexts" class="space-y-1 pt-1 text-[11px]"></div>
                                    </div>

                                    <!-- Source Citation Box (For XNK/Legal Docs) -->
                                    <div id="card-source-box" class="bg-slate-50 px-2.5 py-2 rounded-xl border border-slate-200/80 text-[10px] text-slate-600">
                                        <span class="font-extrabold text-slate-700"><i data-lucide="file-text" class="w-3 h-3 inline mr-1 text-brand-600"></i>Nguồn trích dẫn:</span>
                                        <span id="card-source-text"></span>
                                    </div>

                                    <!-- Reference-Only Expansion (Not Tested) -->
                                    <div class="bg-amber-50/70 p-2.5 rounded-2xl border border-amber-200/80 space-y-1.5" onclick="event.stopPropagation()">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-800">Tham Khảo Mở Rộng</span>
                                            <span class="px-1.5 py-0.5 rounded bg-amber-200/70 text-amber-900 text-[9px] font-extrabold">Chỉ để quen mắt • Không kiểm tra</span>
                                        </div>
                                        <div id="card-reference-variants" class="text-[11px] text-slate-700 space-y-1"></div>
                                    </div>

                                    <!-- Context Example -->
                                    <div class="bg-slate-50 p-2.5 rounded-2xl border border-slate-100 space-y-1">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[10px] font-extrabold uppercase text-slate-400">Ví dụ ngữ cảnh</span>
                                            <button type="button" onclick="event.stopPropagation(); speakWord(currentWordObj().exampleEn, 'en-US', 0.9)" class="text-[10px] font-bold text-brand-600 bg-white px-2 py-0.5 rounded-lg border border-slate-200">
                                                Nghe câu
                                            </button>
                                        </div>
                                        <p id="card-example-en" class="text-xs font-semibold text-slate-800 italic"></p>
                                        <p id="card-example-vi" class="text-[11px] text-slate-500"></p>
                                    </div>
                                </div>

                                <div class="text-center text-[10px] text-slate-400 shrink-0">
                                    Chạm để lật lại • Chuyển sang tab "2. Kiểm Tra 2 Cấp" để đạt Mastered
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Navigation & Optional Sandbox Toggle -->
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="prevCard()" class="flex-1 py-2.5 px-3 rounded-2xl bg-white border border-slate-200 text-slate-700 font-bold text-xs active:scale-95 transition">
                            ← Thẻ trước
                        </button>
                        <button type="button" onclick="setSessionSubView('mastery')" class="flex-1 py-2.5 px-3 rounded-2xl bg-brand-600 text-white font-extrabold text-xs shadow-xs active:scale-95 transition">
                            Kiểm tra từ này →
                        </button>
                        <button type="button" onclick="nextCard()" class="flex-1 py-2.5 px-3 rounded-2xl bg-white border border-slate-200 text-slate-700 font-bold text-xs active:scale-95 transition">
                            Thẻ sau →
                        </button>
                    </div>
                </div>

                <!-- SUB-VIEW 1B: 2-LEVEL MASTERY ASSESSMENT & OPTIONAL SANDBOX -->
                <div id="session-view-mastery" class="hidden space-y-3">
                    <div id="mastery-test-panel" class="bg-white rounded-3xl p-4 border border-slate-200/80 shadow-xs space-y-3"></div>

                    <!-- Optional Sandbox (Does NOT gate mastery) -->
                    <div class="bg-indigo-50/60 rounded-3xl p-4 border border-indigo-200/80 space-y-2.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-indigo-900">Optional Sandbox: Tự Đặt Câu Ứng Dụng</span>
                            <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-700 text-[10px] font-bold">Không khóa tiến độ thẻ</span>
                        </div>
                        <p class="text-[11px] text-indigo-800">Luyện viết câu với từ <strong id="sandbox-target-word">Consignee</strong> để AI sửa ngữ pháp & diễn đạt tự nhiên:</p>
                        <div class="flex gap-1.5">
                            <input type="text" id="sandbox-sentence-input" placeholder="Gõ câu tiếng Anh của bạn..." class="flex-1 px-3 py-2 rounded-xl bg-white border border-indigo-200 text-xs focus:outline-none">
                            <button type="button" onclick="evaluateOptionalSandbox()" class="px-3.5 py-2 rounded-xl bg-indigo-600 text-white font-extrabold text-xs">Chấm AI</button>
                        </div>
                        <div id="sandbox-feedback-box" class="hidden p-2.5 rounded-xl bg-white border border-indigo-200 text-xs text-slate-700 space-y-1"></div>
                    </div>
                </div>

                <!-- SUB-VIEW 1C: MICRO-GRAMMAR IELTS, LINKED PHRASE BANK & DEPENDENCY MAP -->
                <div id="session-view-grammar" class="hidden space-y-3">
                    <div id="micro-grammar-card" class="bg-white rounded-3xl p-4 border border-slate-200/80 shadow-xs space-y-3"></div>

                    <div class="bg-white rounded-3xl p-4 border border-slate-200/80 shadow-xs space-y-2.5">
                        <div class="flex items-center justify-between">
                            <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider">Cấu Trúc Câu Liên Kết (1 Cấu Trúc • 3 Ví Dụ)</h3>
                            <span class="text-[10px] font-bold text-brand-600">Single Source of Truth</span>
                        </div>
                        <div id="linked-phrases-list" class="space-y-2"></div>
                    </div>

                    <div class="bg-white rounded-3xl p-4 border border-slate-200/80 shadow-xs space-y-2.5">
                        <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider">Bản Đồ Tiên Quyết (Grammar Dependency Map)</h3>
                        <div id="grammar-dependency-map" class="space-y-1.5"></div>
                    </div>
                </div>
            </section>

            <!-- =================================================================== -->
            <!-- TAB 2: THƯ VIỆN NGHE 3 CẤP ĐỘ & CHẤM PHÁT ÂM WEB SPEECH TRUNG THỰC  -->
            <!-- =================================================================== -->
            <section id="tab-listening" class="hidden space-y-3.5 animate-slide-up">
                <div class="bg-white rounded-3xl p-4 border border-slate-200/80 shadow-xs space-y-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="text-sm font-extrabold text-slate-900">Thư Viện Nghe 3 Cấp Độ</h2>
                            <p class="text-[11px] text-slate-500">Understand → Recognize (Điền từ & Nối âm) → Reproduce</p>
                        </div>
                        <select id="listening-channel-select" onchange="renderListeningLibrary()" class="px-2.5 py-1.5 rounded-xl bg-slate-100 text-xs font-extrabold text-slate-700 border border-slate-200">
                            <option value="all">Tất cả 6 kênh</option>
                            <option value="logistics">Logistics English</option>
                            <option value="legal">Legal English</option>
                            <option value="daily">Daily Conversation</option>
                            <option value="business">Business English</option>
                            <option value="slow">Slow English</option>
                            <option value="ielts">IELTS Listening</option>
                        </select>
                    </div>

                    <div id="listening-tracks-list" class="flex gap-2 overflow-x-auto no-scrollbar pb-1"></div>

                    <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-2xl border border-slate-200/80">
                        <div class="flex items-center gap-1.5">
