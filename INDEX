        function extractVocabFromSource() {
            const text = document.getElementById("importer-raw-text").value.trim();
            if (!text) {
                showToast("Hãy nhập văn bản hoặc tải file PDF/DOCX/Ảnh trước!");
                return;
            }
            const tokens = text.match(/[A-Za-z]{6,}/g) || [];
            const stop = new Set(["please", "within", "before", "should", "during", "through", "between", "heading", "without", "because"]);
            const unique = [...new Set(tokens.map(t => t.toLowerCase()))].filter(t => !stop.has(t)).slice(0, 5);

            lastExtractedImportWords = unique.map((tok, i) => {
                const cap = tok.charAt(0).toUpperCase() + tok.slice(1);
                const known = CORE_VOCABULARY_BANK.find(v => v.headword.toLowerCase() === tok);
                const snippet = text.split(/\n/)[0].slice(0, 110);
                return known ? { ...known, source: `${lastImportedSourceMeta.filename} (${lastImportedSourceMeta.location})` } : {
                    id: `custom_${Date.now()}_${i}`,
                    headword: cap,
                    pos: "n/v",
                    ipa: "/.../",
                    domain: "Tài liệu Tùy chỉnh",
                    category: "Chuyên ngành",
                    coreMeaning: `Thuật ngữ trích từ ${lastImportedSourceMeta.filename}`,
                    contexts: [{ label: lastImportedSourceMeta.location, desc: snippet }],
                    source: `${lastImportedSourceMeta.filename} • ${lastImportedSourceMeta.location} • Trích: "${snippet}..."`,
                    referenceVariants: [`${cap} + N / Prep (Tham khảo ngữ cảnh tài liệu)`],
                    exampleEn: snippet + ".",
                    exampleVi: "Đoạn trích từ tài liệu đã tải lên.",
                    recallBlankSentence: snippet.replace(new RegExp(cap, "gi"), "________") + "."
                };
            });

            const box = document.getElementById("importer-vocab-results");
            box.classList.remove("hidden");
            box.innerHTML = `
                <div class="flex items-center justify-between">
                    <span class="text-xs font-extrabold text-slate-800">Từ trích xuất (${lastExtractedImportWords.length} từ):</span>
                    <button type="button" onclick="saveAllToCustomQueue()" class="text-xs font-extrabold text-emerald-600">+ Đẩy tất cả vào CustomQueue</button>
                </div>
                ${lastExtractedImportWords.map((w, idx) => `
                    <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-2 text-xs">
                        <div>
                            <p class="font-extrabold text-slate-900">${w.headword} <span class="font-normal text-slate-400">(${w.pos})</span></p>
                            <p class="text-[10px] text-slate-500">${w.source}</p>
                        </div>
                        <button type="button" onclick="saveOneToCustomQueue(${idx})" class="px-2.5 py-1 rounded-lg bg-brand-600 text-white font-bold text-[11px] shrink-0">+ Lưu</button>
                    </div>
                `).join("")}
            `;
        }

        function saveOneToCustomQueue(idx) {
            const item = lastExtractedImportWords[idx];
            if (!item) return;
            window.appState.customQueue.unshift(item);
            saveStateToLocal();
            renderCustomQueueList();
            showToast(`Đã thêm "${item.headword}" vào CustomQueue!`);
        }

        function saveAllToCustomQueue() {
            lastExtractedImportWords.forEach(item => window.appState.customQueue.unshift(item));
            saveStateToLocal();
            renderCustomQueueList();
            showToast(`Đã đẩy ${lastExtractedImportWords.length} từ vào CustomQueue!`);
        }

        function buildDialogueDraftFromSource() {
            const text = document.getElementById("importer-raw-text").value.trim();
            if (!text) {
                showToast("Vui lòng nhập nội dung tài liệu trước khi tạo bản nháp hội thoại!");
                return;
            }
            const firstLines = text.split(/\n/).filter(Boolean).slice(0, 2).join(" ").slice(0, 140);
            document.getElementById("dialogue-draft-editor").classList.remove("hidden");
            document.getElementById("draft-dialogue-title").value = `Hội thoại từ: ${lastImportedSourceMeta.filename}`;
            document.getElementById("draft-dialogue-script").value =
                `Officer A: Hello, I am reviewing the document regarding: "${firstLines}".\n` +
                `Specialist B: Yes, let's verify all terms and liabilities carefully before we proceed.\n` +
                `Officer A: Agreed, I will confirm the details once the review is complete.`;
            showToast("Đã tạo Bản Nháp (Draft). Vui lòng kiểm tra thuật ngữ trước khi xuất bản!");
        }

        function previewDraftDialogueAudio() {
            const script = document.getElementById("draft-dialogue-script").value;
            speakWord(script, "en-US", 0.95);
        }

        function publishDraftDialogueToLibrary() {
            const title = document.getElementById("draft-dialogue-title").value.trim() || "Custom Document Dialogue";
            const script = document.getElementById("draft-dialogue-script").value.trim();
            if (!script) return;

            const parsedLines = script.split(/\n/).filter(Boolean).map(rawLine => {
                const parts = rawLine.split(":");
                const speaker = parts.length > 1 ? parts[0].trim() : "Speaker";
                const en = parts.length > 1 ? parts.slice(1).join(":").trim() : rawLine;
                return { speaker, en, vi: "(Bản dịch tự động từ tài liệu đã duyệt)" };
            });

            window.appState.customListeningTracks.unshift({
                id: `cust_lt_${Date.now()}`,
                channel: "logistics",
                title: title,
                level: "Custom Draft Published",
                speakers: ["Speaker A", "Speaker B"],
                lines: parsedLines,
                comprehensionQ: "What is the main focus of this reviewed dialogue?",
                comprehensionOptions: ["Verifying document terms and details", "Booking a vacation flight", "Ordering lunch"],
                comprehensionAnswer: "Verifying document terms and details",
                clozeTargets: ["document", "verify", "details"],
                connectedSpeechNotes: ["• Hội thoại được xuất bản từ bản nháp đã kiểm duyệt của bạn."]
            });

            document.getElementById("dialogue-draft-editor").classList.add("hidden");
            saveStateToLocal();
            showToast("Đã duyệt & xuất bản hội thoại vào Thư Viện Nghe 3 Cấp Độ!");
            switchTab("listening");
        }

        function toggleAutoInterleave(checked) {
            window.appState.autoInterleave = checked;
            saveStateToLocal();
            showToast(checked ? "Bật Auto Interleave: Đan xen từ tùy chỉnh & giữ nguyên tổng tải!" : "Tắt Auto Interleave: Chỉ học từ cốt lõi.");
        }

        function renderCustomQueueList() {
            document.getElementById("auto-interleave-toggle").checked = !!window.appState.autoInterleave;
            const list = document.getElementById("custom-queue-list");
            if (!window.appState.customQueue.length) {
                list.innerHTML = `<p class="py-3 text-slate-400 text-center">Chưa có từ tùy chỉnh nào. Hãy quét PDF/DOCX/Ảnh ở trên!</p>`;
                return;
            }
            list.innerHTML = window.appState.customQueue.map(w => `
                <div class="py-2 flex items-center justify-between gap-2">
                    <div>
                        <p class="font-extrabold text-slate-800">${w.headword} <span class="font-normal text-slate-400">(${w.pos})</span></p>
                        <p class="text-[10px] text-slate-500">${w.source}</p>
                    </div>
                    <button type="button" onclick="speakWord('${w.headword.replace(/'/g, "\\'")}', 'en-US', 0.95)" class="p-1.5 rounded-lg bg-brand-50 text-brand-600">
                        <i data-lucide="volume-2" class="w-3.5 h-3.5"></i>
                    </button>
                </div>
            `).join("");
            lucide.createIcons();
        }

        // =========================================================================
        // 11. TAB 5: 2D ERROR NOTEBOOK (ACTIVE -> RECOVERED -> ARCHIVED + REOPEN + DELETE)
        // =========================================================================
        function logErrorToNotebook(skill, errorCategory, rootCause, contextSentence, correctAnswer) {
            const today = getTodayDateISO();
            const existing = window.appState.errorNotebook.find(e => e.skill === skill && e.errorCategory === errorCategory && e.rootCause === rootCause);
            if (existing) {
                existing.recurrenceCount = (existing.recurrenceCount || 1) + 1;
                existing.lastDate = today;
                if (existing.status === "Recovered" || existing.status === "Archived") {
                    existing.status = "Active";
                    existing.recoveryPasses = 0;
                }
            } else {
                window.appState.errorNotebook.unshift({
                    errorId: `ERR-${Date.now().toString().slice(-4)}`,
                    skill,
                    errorCategory,
                    rootCause,
                    recurrenceCount: 1,
                    firstDate: today,
                    lastDate: today,
                    recoveryPasses: 0,
                    lastRecoveryDate: null,
                    status: "Active",
                    drillQuestion: contextSentence,
                    drillOptions: [correctAnswer, "incorrect_option_1", "incorrect_option_2"],
                    drillAnswer: correctAnswer
                });
            }
            evaluateProgressionGates();
        }

        function renderErrorNotebook() {
            const fSkill = document.getElementById("err-filter-skill").value;
            const fCat = document.getElementById("err-filter-cat").value;
            const fStatus = document.getElementById("err-filter-status").value;
            const fromD = document.getElementById("report-from-date").value;
            const toD = document.getElementById("report-to-date").value;

            const activeTotal = window.appState.errorNotebook.filter(e => e.status === "Active").length;
            document.getElementById("active-errors-badge").textContent = `${activeTotal} Active`;

            const filtered = window.appState.errorNotebook.filter(e => {
                if (fSkill !== "all" && e.skill !== fSkill) return false;
                if (fCat !== "all" && e.errorCategory !== fCat) return false;
                if (fStatus !== "all" && e.status !== fStatus) return false;
                if (fromD && e.lastDate < fromD) return false;
                if (toD && e.lastDate > toD) return false;
                return true;
            });

            const container = document.getElementById("error-notebook-items");
            if (!filtered.length) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">Không có lỗi nào khớp bộ lọc hiện tại.</p>`;
                return;
            }

            container.innerHTML = filtered.map(err => `
                <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2 text-xs">
                    <div class="flex items-center justify-between gap-1.5">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="px-2 py-0.5 rounded bg-indigo-100 text-indigo-800 text-[10px] font-extrabold">${err.skill} × ${err.errorCategory}</span>
                            <span class="px-2 py-0.5 rounded bg-rose-100 text-rose-700 text-[10px] font-bold">Tái phạm: ${err.recurrenceCount}x</span>
                        </div>
                        <span class="text-[10px] font-extrabold ${err.status === 'Active' ? 'text-rose-600' : (err.status === 'Recovered' ? 'text-emerald-600' : 'text-slate-400')}">${err.status}</span>
                    </div>
                    <p class="font-bold text-slate-800 leading-relaxed">${err.rootCause}</p>
                    <p class="text-[10px] text-slate-400">Phát sinh: ${err.firstDate} • Gần nhất: ${err.lastDate} • Lượt khắc phục: ${err.recoveryPasses || 0}/2</p>

                    <div class="flex flex-wrap gap-1.5 pt-1">
                        ${err.status === "Active" ? `
                            <button type="button" onclick="attemptErrorRecovery('${err.errorId}')" class="px-2.5 py-1 rounded-lg bg-emerald-600 text-white font-bold text-[10px]">
                                Luyện câu hỏi khắc phục
                            </button>
                            <button type="button" onclick="archiveErrorItem('${err.errorId}')" class="px-2.5 py-1 rounded-lg bg-slate-200 text-slate-700 font-bold text-[10px]">
                                Archived (Ẩn)
                            </button>
                        ` : `
                            <button type="button" onclick="reopenErrorItem('${err.errorId}')" class="px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 font-bold text-[10px]">
                                Reopen (Mở lại)
                            </button>
                        `}
                        <button type="button" onclick="promptDeleteErrorPermanently('${err.errorId}')" class="px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 font-bold text-[10px]">
                            Delete Permanently
                        </button>
                    </div>
                </div>
            `).join("");
        }

        function attemptErrorRecovery(errorId) {
            const err = window.appState.errorNotebook.find(e => e.errorId === errorId);
            if (!err) return;
            const today = getTodayDateISO();
            if (err.lastRecoveryDate && err.lastRecoveryDate === today) {
                showToast("Bạn đã vượt qua lượt kiểm tra hôm nay. Hãy quay lại sau ít nhất 3 ngày để xác nhận Recovered!");
                return;
            }
            err.recoveryPasses = (err.recoveryPasses || 0) + 1;
            err.lastRecoveryDate = today;
            if (err.recoveryPasses >= 2) {
                err.status = "Recovered";
                // Clear matching ProgressionGate if active errors in this group drop below 5
                window.appState.progressionGates.forEach(g => {
                    if (g.skill === err.skill && g.errorCategory === err.errorCategory) {
                        g.status = "Cleared";
                        g.history.push({ clearedAt: today });
                    }
                });
                showToast(`🎉 Lỗi ${err.errorId} đã chuyển sang trạng thái RECOVERED!`);
            } else {
                showToast(`✓ Đạt lượt khắc phục 1/2! Cần đúng thêm 1 câu mới sau ≥ 3 ngày để chuyển Recovered.`);
            }
            saveStateToLocal();
            refreshAllUI();
        }

        function archiveErrorItem(errorId) {
            const err = window.appState.errorNotebook.find(e => e.errorId === errorId);
            if (err) err.status = "Archived";
            saveStateToLocal();
            renderErrorNotebook();
            showToast("Đã chuyển lỗi sang Archived (ẩn khỏi danh sách ôn, vẫn giữ lịch sử).");
        }

        function reopenErrorItem(errorId) {
            const err = window.appState.errorNotebook.find(e => e.errorId === errorId);
            if (err) {
                err.status = "Active";
                err.recoveryPasses = 0;
            }
            saveStateToLocal();
            renderErrorNotebook();
            showToast("Đã mở lại lỗi (Reopen) về trạng thái Active.");
        }

        function promptDeleteErrorPermanently(errorId) {
            openConfirmModal(
                "Xóa vĩnh viễn bản ghi lỗi?",
                `Bạn có chắc chắn muốn xóa hẳn mã lỗi ${errorId} khỏi cơ sở dữ liệu? Thao tác này không thể hoàn tác.`,
                () => {
                    window.appState.errorNotebook = window.appState.errorNotebook.filter(e => e.errorId !== errorId);
                    saveStateToLocal();
                    refreshAllUI();
                    showToast("Đã xóa vĩnh viễn bản ghi lỗi.");
                }
            );
        }

        // --- 22:00 RFC 5545 .ICS CALENDAR & DATE-RANGE EXPORT ---
        function saveReminderTime(val) {
            window.appState.reminderTime = val || "22:00";
            saveStateToLocal();
            showToast(`Đã lưu khung giờ nhắc nhở: ${window.appState.reminderTime}`);
        }

        function requestWebPushPermission() {
            if (!("Notification" in window)) {
                showToast("Trình duyệt không hỗ trợ Notification API. Hãy dùng nút Tải Lịch .ICS!");
                return;
            }
            Notification.requestPermission().then(res => {
                if (res === "granted") showToast(`Đã cấp quyền thông báo trình duyệt lúc ${window.appState.reminderTime}!`);
            });
        }

        function downloadRfc5545Ics() {
            const [hh, mm] = (window.appState.reminderTime || "22:00").split(":");
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "Asia/Ho_Chi_Minh";
            const todayClean = getTodayDateISO().replace(/-/g, "");
            const endMm = String(Math.min(59, parseInt(mm, 10) + 20)).padStart(2, "0");

            const icsContent = [
                "BEGIN:VCALENDAR",
                "VERSION:2.0",
                "PRODID:-//DailySpeak & Master 365 v5.0//VI",
                "CALSCALE:GREGORIAN",
                "BEGIN:VEVENT",
                `UID:dailyspeak-365-${Date.now()}@app`,
                `DTSTAMP:${todayClean}T120000Z`,
                `DTSTART;TZID=${tz}:${todayClean}T${hh}${mm}00`,
                `DTEND;TZID=${tz}:${todayClean}T${hh}${endMm}00`,
                "RRULE:FREQ=DAILY",
                "SUMMARY:📚 Học Tiếng Anh Hằng Ngày — DailySpeak & Master 365",
                "DESCRIPTION:Đến giờ hoàn thành phiên học từ vựng, ngữ pháp IELTS & luyện nghe nói!",
                "BEGIN:VALARM",
                "TRIGGER:-PT0M",
                "ACTION:DISPLAY",
                "DESCRIPTION:Nhắc nhở học tiếng Anh 22:00 hằng ngày",
                "END:VALARM",
                "END:VEVENT",
                "END:VCALENDAR"
            ].join("\r\n");

            const blob = new Blob([icsContent], { type: "text/calendar;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `DailySpeak_22h_Reminder_${tz.replace(/\//g, "_")}.ics`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Đã tải tệp lịch .ICS chuẩn RFC 5545! Mở tệp để thêm vào lịch điện thoại.");
        }

        function exportProgressCsv() {
            const fromD = document.getElementById("report-from-date").value;
            const toD = document.getElementById("report-to-date").value;
            const headers = ["RouteCode", "MemberName", "Word_ID", "Headword", "Domain", "Mastery_Status", "SRS_Interval_Days", "Next_Due_Date"];
            const filteredWords = [...CORE_VOCABULARY_BANK, ...window.appState.customQueue].filter(w => {
                const m = window.appState.wordMastery[w.id];
                if (!fromD && !toD) return true;
                if (!m || !m.nextDueDate) return true;
                if (fromD && m.nextDueDate < fromD) return false;
                if (toD && m.nextDueDate > toD) return false;
                return true;
            });
            const rows = [
                headers.join(","),
                ...filteredWords.map(w => {
                    const m = window.appState.wordMastery[w.id] || {};
                    return [
                        window.appState.routeCode,
                        `"${window.appState.memberName}"`,
                        w.id,
                        `"${w.headword}"`,
                        `"${w.domain || ''}"`,
                        m.status || "New",
                        m.srsIntervalDays || 0,
                        m.nextDueDate || ""
                    ].join(",");
                })
            ];
            const blob = new Blob(["\uFEFF" + rows.join("\n")], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `DailySpeak_${window.appState.memberName}_${fromD || 'ALL'}_to_${toD || getTodayDateISO()}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast(`Đã xuất báo cáo Excel (CSV) cho ${window.appState.memberName}!`);
        }

        function exportProgressWordDoc() {
            const fromD = document.getElementById("report-from-date").value || "Khởi đầu";
            const toD = document.getElementById("report-to-date").value || getTodayDateISO();
            const stats = computeCurrentProfileStats();
            const wordsHtml = [...CORE_VOCABULARY_BANK, ...window.appState.customQueue].map((w, i) => `
                <tr>
                    <td style="border:1px solid #cbd5e1;padding:6px;">${i + 1}</td>
                    <td style="border:1px solid #cbd5e1;padding:6px;"><strong>${w.headword}</strong> (${w.pos})</td>
                    <td style="border:1px solid #cbd5e1;padding:6px;">${w.domain}</td>
                    <td style="border:1px solid #cbd5e1;padding:6px;">${w.coreMeaning}</td>
                    <td style="border:1px solid #cbd5e1;padding:6px;">${window.appState.wordMastery[w.id]?.status || 'New'}</td>
                </tr>
            `).join("");

            const htmlDoc = `
                <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
                <head><meta charset='utf-8'><title>Báo Cáo Học Tập</title></head>
                <body style="font-family:Arial,sans-serif;">
                    <h2>BÁO CÁO TIẾN ĐỘ HỌC TIẾNG ANH — DAILYSPEAK & MASTER 365</h2>
                    <p><strong>Học viên:</strong> ${stats.memberName} | <strong>Mã lộ trình:</strong> ${stats.routeCode}</p>
                    <p><strong>Khoảng thời gian xuất:</strong> Từ ${fromD} đến ${toD}</p>
                    <p><strong>Thành tích:</strong> Hoàn thành ${stats.completedSessions}/348 phiên • Chuỗi ${stats.streakDays} ngày • Độ chính xác ${stats.accuracy}% • Đã khắc phục ${stats.recoveredCount} lỗi</p>
                    <table style="border-collapse:collapse;width:100%;font-size:12px;">
                        <thead>
                            <tr style="background:#eef2ff;">
                                <th style="border:1px solid #cbd5e1;padding:6px;">STT</th>
                                <th style="border:1px solid #cbd5e1;padding:6px;">Từ vựng</th>
                                <th style="border:1px solid #cbd5e1;padding:6px;">Lĩnh vực</th>
                                <th style="border:1px solid #cbd5e1;padding:6px;">Nghĩa cốt lõi</th>
                                <th style="border:1px solid #cbd5e1;padding:6px;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>${wordsHtml}</tbody>
                    </table>
                </body></html>
            `;
            const blob = new Blob(["\uFEFF" + htmlDoc], { type: "application/msword;charset=utf-8" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `BaoCao_DailySpeak_${stats.memberName}_${fromD}_den_${toD}.doc`;
            a.click();
            URL.revokeObjectURL(url);
            showToast(`Đã xuất báo cáo Word (.DOC) từ ${fromD} đến ${toD}!`);
        }

        function exportFullBackupJson() {
            const blob = new Blob([JSON.stringify(window.appState, null, 2)], { type: "application/json" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `DailySpeak_Backup_${window.appState.syncCode}_${getTodayDateISO()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast("Đã xuất tệp sao lưu toàn bộ dữ liệu JSON!");
        }

        // =========================================================================
        // 12. SPEECH HELPER, MODAL CONTROLS & TAB ROUTER
        // =========================================================================
        function speakWord(text, lang = "en-US", rate = 0.95) {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance(text);
            u.lang = lang;
            u.rate = rate;
            window.speechSynthesis.speak(u);
        }

        function openConfirmModal(title, body, onConfirm) {
            document.getElementById("confirm-modal-title").textContent = title;
            document.getElementById("confirm-modal-body").textContent = body;
            document.getElementById("custom-confirm-modal").classList.remove("hidden");
            document.getElementById("confirm-modal-ok-btn").onclick = () => {
                closeConfirmModal();
                if (onConfirm) onConfirm();
            };
        }

        function closeConfirmModal() {
            document.getElementById("custom-confirm-modal").classList.add("hidden");
        }

        function switchTab(tabName) {
            activeTab = tabName;
            ['session', 'listening', 'studio', 'importer', 'errors'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.toggle("hidden", t !== tabName);
                document.getElementById(`nav-${t}`).className = t === tabName
                    ? "flex flex-col items-center justify-center py-1.5 rounded-2xl text-brand-600 font-extrabold transition"
                    : "flex flex-col items-center justify-center py-1.5 rounded-2xl text-slate-400 font-semibold transition";
            });

            if (tabName === "session") renderSessionTab();
            if (tabName === "listening") renderListeningLibrary();
            if (tabName === "studio") setStudioSubView("speaking");
            if (tabName === "importer") renderCustomQueueList();
            if (tabName === "errors") renderErrorNotebook();
            lucide.createIcons();
        }

        window.refreshAllUI = function() {
            evaluateProgressionGates();
            const gated = isProgressionGated();
            const gateBanner = document.getElementById("progression-gate-banner");
            gateBanner.classList.toggle("hidden", !gated);
            if (gated) {
                const firstGate = window.appState.progressionGates.find(g => g.status === "Gated");
                document.getElementById("gate-reason-text").textContent = firstGate?.reason || "Cần hoàn thành bài củng cố nhóm lỗi yếu.";
            }
            switchTab(activeTab);
        };

        let toastHandle = null;
        window.showToast = function(msg) {
            const el = document.getElementById("toast-banner");
            el.textContent = msg;
            el.classList.remove("hidden");
            clearTimeout(toastHandle);
            toastHandle = setTimeout(() => el.classList.add("hidden"), 3000);
        };

        window.onload = function() {
            loadRegistryFromLocal();
            if (window.appState) {
                document.getElementById("daily-reminder-time").value = window.appState.reminderTime || "22:00";
                window.refreshAllUI();
            }
            if ('speechSynthesis' in window) window.speechSynthesis.getVoices();
            lucide.createIcons();
        };
    </script>
</body>
