        async function submitAdminMasterGate() {
            const adminName = (document.getElementById("gate-admin-name-input").value || "").trim();
            const rawSecret = (document.getElementById("gate-admin-secret-input").value || "").trim();
            const btn = document.getElementById("gate-admin-submit-btn");

            if (!adminName) {
                showGateError("Vui lòng nhập tên Quản Trị Viên.");
                return;
            }
            if (!rawSecret) {
                showGateError("Vui lòng nhập Mật khẩu Chủ Quản Trị.");
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.textContent = "Đang xác thực trên đám mây...";
            }

            if (typeof window.fetchLatestAdminRegistryFromCloud === "function") {
                await window.fetchLatestAdminRegistryFromCloud();
            }

            if (btn) {
                btn.disabled = false;
                btn.textContent = "Đăng Nhập Quyền Quản Trị Viên (Admin) →";
            }

            const expectedSecret = (window.registryState.adminSecret || "ADMIN-2026").trim();
            if (rawSecret.toLowerCase() !== expectedSecret.toLowerCase()) {
                showGateError("Mật khẩu Chủ Quản Trị không chính xác! (Nếu chưa đổi, mật khẩu mặc định là ADMIN-2026)");
                return;
            }

            const existingAdmin = Object.values(window.registryState.profiles).find(p => p.role === "admin");
            if (existingAdmin) {
                existingAdmin.memberName = adminName;
                activateMemberSession(existingAdmin);
            } else {
                const newAdminId = `admin_${Date.now()}`;
                const adminProfile = createDefaultMemberProfileState(newAdminId, adminName, "", "admin", "ADMIN-MASTER");
                activateMemberSession(adminProfile);
            }
            showToast(`Chào mừng Quản Trị Viên ${adminName}!`);
        }

        async function submitMemberInviteGate() {
            const inviteKey = (document.getElementById("gate-invite-key-input").value || "").trim().toUpperCase();
            const memberName = (document.getElementById("gate-member-name-input").value || "").trim();
            const memberPin = (document.getElementById("gate-member-pin-input").value || "").trim();

            if (!inviteKey) {
                showGateError("Bạn cần có Mã Mời riêng do Quản Trị Viên cấp để truy cập.");
                return;
            }

            if (typeof window.fetchLatestAdminRegistryFromCloud === "function") {
                await window.fetchLatestAdminRegistryFromCloud();
            }

            const keyEntry = window.registryState.issuedKeys[inviteKey];
            if (!keyEntry) {
                showGateError("Mã Mời không tồn tại hoặc chưa được Quản Trị Viên cấp phép!");
                return;
            }
            if (keyEntry.active === false) {
                showGateError("Mã Mời này đã bị Quản Trị Viên thu hồi quyền truy cập!");
                return;
            }

            const finalName = memberName || keyEntry.assignedName || "Thành viên";
            const existing = Object.values(window.registryState.profiles).find(p => p.inviteKey === inviteKey);

            if (existing) {
                if (existing.memberPin && existing.memberPin !== memberPin) {
                    showGateError(`Mã PIN 4 số của hồ sơ "${existing.memberName}" không chính xác!`);
                    return;
                }
                if (memberName) existing.memberName = memberName;
                activateMemberSession(existing);
            } else {
                const newId = `mem_${Date.now()}`;
                const newProf = createDefaultMemberProfileState(newId, finalName, memberPin, "member", inviteKey);
                keyEntry.usedByMemberId = newId;
                activateMemberSession(newProf);
            }
        }

