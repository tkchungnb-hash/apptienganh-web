        function computeCurrentProfileStats(prof = window.appState) {
            const completedSessions = prof.curriculumSessions.filter(s => s.status === "Completed").length;
            const completionRate = Math.round((completedSessions / TOTAL_CURRICULUM_SESSIONS) * 1000) / 10;
            const masteredWords = Object.values(prof.wordMastery || {}).filter(m => m.status === "Mastered").length;
            const activeDays = Object.values(prof.calendarDayRecords || {}).filter(d => d.status === "Active").length;
            const streakDays = Math.max(activeDays, completedSessions > 0 ? 1 : 0);
            const totalValid = (prof.skillMetrics.Vocabulary?.validCount || 0) + (prof.skillMetrics.Grammar?.validCount || 0);
            const totalRight = (prof.skillMetrics.Vocabulary?.correctCount || 0) + (prof.skillMetrics.Grammar?.correctCount || 0);
            const accuracy = totalValid > 0 ? Math.round((totalRight / totalValid) * 100) : 100;
            const recoveredCount = (prof.errorNotebook || []).filter(e => e.status === "Recovered").length;
            const xpScore = completedSessions * 100 + masteredWords * 15 + streakDays * 25 + recoveredCount * 30;

            return {
                memberId: prof.activeMemberId,
                memberName: prof.memberName,
                role: prof.role || "member",
                inviteKey: prof.inviteKey || "",
                routeCode: prof.routeCode,
                currentSessionNumber: prof.currentSessionNumber || 1,
                completedSessions,
                completionRate,
                masteredWords,
                streakDays,
                accuracy,
                recoveredCount,
                xpScore
            };
        }

