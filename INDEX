        }

        function getSessionVocabularyList(sessionNum) {
            // Strictly balanced 6 words per session: 2 Daily + 2 Specialized (Log/Legal) + 2 IELTS Academic
            const dailyPool = CORE_VOCABULARY_BANK.filter(w => w.category === "Đời sống");
            const specPool = CORE_VOCABULARY_BANK.filter(w => w.category === "Chuyên ngành");
            const ieltsPool = CORE_VOCABULARY_BANK.filter(w => w.category === "IELTS Academic");

            const idxA = ((sessionNum - 1) * 2) % dailyPool.length;
            const idxB = ((sessionNum - 1) * 2) % specPool.length;
            const idxC = ((sessionNum - 1) * 2) % ieltsPool.length;

            let list = [
                dailyPool[idxA],
                dailyPool[(idxA + 1) % dailyPool.length],
                specPool[idxB],
                specPool[(idxB + 1) % specPool.length],
                ieltsPool[idxC],
                ieltsPool[(idxC + 1) % ieltsPool.length]
            ];

            // Auto Interleave: replace up to 1 slot with CustomQueue without exceeding 6 words
            if (window.appState.autoInterleave && window.appState.customQueue.length > 0) {
                const customItem = window.appState.customQueue[(sessionNum - 1) % window.appState.customQueue.length];
                const displaced = list[list.length - 1];
                if (!window.appState.deferredCoreIds.includes(displaced.id)) {
                    window.appState.deferredCoreIds.push(displaced.id);
                }
                list[list.length - 1] = customItem;
            }
            return list;
        }

