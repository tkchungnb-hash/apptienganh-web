        async function importPdfDocument(event) {
            const file = event.target.files?.[0];
            if (!file) return;
            const pFrom = Math.max(1, parseInt(document.getElementById("pdf-page-from").value, 10) || 1);
            const pTo = Math.max(pFrom, parseInt(document.getElementById("pdf-page-to").value, 10) || 3);
            showImporterStatus(`Đang đọc PDF "${file.name}" (Trang ${pFrom} → ${pTo}) bằng PDF.js...`);

            try {
                const buffer = await file.arrayBuffer();
                const pdf = await pdfjsLib.getDocument({ data: buffer }).promise;
                let combinedText = "";
                let usedOcrFallback = false;
                const startPage = Math.min(pFrom, pdf.numPages);
                const endPage = Math.min(pTo, pdf.numPages);

                for (let p = startPage; p <= endPage; p++) {
                    const page = await pdf.getPage(p);
                    const textContent = await page.getTextContent();
                    const pageStr = textContent.items.map(it => it.str).join(" ").trim();

                    if (pageStr.length > 35) {
                        combinedText += `[Trang ${p}]: ${pageStr}\n\n`;
                    } else {
                        // Scanned PDF page -> render to canvas -> Tesseract.js OCR
                        usedOcrFallback = true;
                        showImporterStatus(`Trang ${p} là bản scan ảnh — đang render sang Canvas & chạy Tesseract OCR...`, true);
                        const viewport = page.getViewport({ scale: 1.5 });
                        const canvas = document.createElement("canvas");
                        canvas.width = viewport.width;
                        canvas.height = viewport.height;
                        await page.render({ canvasContext: canvas.getContext("2d"), viewport }).promise;
                        const ocrRes = await Tesseract.recognize(canvas, "eng");
                        combinedText += `[Trang ${p} - OCR Scan]: ${ocrRes.data.text.trim()}\n\n`;
                    }
                }

                lastImportedSourceMeta = {
                    filename: file.name,
                    location: `Trang ${startPage}–${endPage}/${pdf.numPages} (PDF)`,
                    isOcrUncertain: usedOcrFallback
                };
                document.getElementById("importer-raw-text").value = combinedText.trim();
                showImporterStatus(
                    usedOcrFallback
                        ? `⚠️ Đã trích xuất PDF scan (Trang ${startPage}–${endPage}) qua OCR. <strong>Cần kiểm tra lại</strong> chính tả các mã vận đơn/thuật ngữ trước khi lưu!`
                        : `✓ Đã trích xuất thành công trang ${startPage}–${endPage} từ "${file.name}".`,
                    usedOcrFallback
                );
            } catch (e) {
                showImporterStatus("Lỗi đọc file PDF. Vui lòng kiểm tra định dạng tệp.", true);
            }
        }

        async function importDocxDocument(event) {
            const file = event.target.files?.[0];
            if (!file) return;
            showImporterStatus(`Đang đọc file Word "${file.name}" qua Mammoth.js...`);

            try {
                const arrayBuffer = await file.arrayBuffer();
                const result = await mammoth.convertToHtml({ arrayBuffer });
                // Sanitize HTML before parsing DOM
                const parser = new DOMParser();
                const docHtml = parser.parseFromString(result.value, "text/html");
                docHtml.querySelectorAll("script, style, iframe, object, embed").forEach(el => el.remove());

                let nearestHeading = "Mở đầu tài liệu";
                let paraCount = 0;
                const lines = [];

                docHtml.body.querySelectorAll("h1, h2, h3, h4, p, li, td").forEach(el => {
                    const txt = el.textContent.trim();
                    if (!txt) return;
                    if (/^H[1-4]$/.test(el.tagName)) {
                        nearestHeading = txt;
                    } else {
                        paraCount++;
                        lines.push(`[Heading: ${nearestHeading} | Đoạn #${paraCount}]: ${txt}`);
                    }
                });

                lastImportedSourceMeta = {
                    filename: file.name,
                    location: `Heading "${nearestHeading}" • Tổng ${paraCount} đoạn văn (DOCX)`,
                    isOcrUncertain: false
                };
                document.getElementById("importer-raw-text").value = lines.join("\n");
                showImporterStatus(`✓ Đã trích xuất ${paraCount} đoạn văn từ "${file.name}" (đã làm sạch HTML & lưu Heading).`);
            } catch (e) {
                showImporterStatus("Không thể đọc file .docx này.", true);
            }
        }

