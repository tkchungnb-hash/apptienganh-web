        function submitLevel1Recognition(targetId, chosenId) {
            const elapsedSec = (performance.now() - questionRenderedAt) / 1000;
            const today = getTodayDateISO();
            if (!window.appState.wordMastery[targetId]) {
                window.appState.wordMastery[targetId] = { status: "Learning", level1Passes: 0, fastStreak: 0, srsIntervalDays: 0, nextDueDate: today };
            }
            const m = window.appState.wordMastery[targetId];
            window.appState.skillMetrics.Vocabulary.validCount++;

            if (targetId === chosenId) {
                window.appState.skillMetrics.Vocabulary.correctCount++;
                m.level1Passes++;
                if (elapsedSec < 4.0) {
                    m.fastStreak = (m.fastStreak || 0) + 1;
                    m.srsIntervalDays = m.fastStreak === 1 ? 7 : (m.fastStreak === 2 ? 14 : 30);
                    m.nextDueDate = addDaysISO(today, m.srsIntervalDays);
                    showToast(`✓ Đúng & Nhanh (${elapsedSec.toFixed(1)}s)! Giãn SRS +${m.srsIntervalDays} ngày.`);
                } else {
                    m.fastStreak = 0;
                    m.srsIntervalDays = 1;
                    m.nextDueDate = addDaysISO(today, 1);
                    showToast(`✓ Đúng (${elapsedSec.toFixed(1)}s ≥ 4s). Ôn lại vào ngày kế tiếp.`);
                }
            } else {
                m.fastStreak = 0;
                m.srsIntervalDays = 0;
                m.nextDueDate = today;
                const w = CORE_VOCABULARY_BANK.find(x => x.id === targetId);
                logErrorToNotebook("Vocabulary", "Confused Words", `Nhầm nghĩa của từ "${w?.headword || targetId}"`, w?.exampleEn || "", w?.headword || "");
