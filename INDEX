        // Honest Web Speech Normalization & Comparison (Matched / Missing / Extra / Recognition Confidence)
        function normalizeSpeechTokens(text) {
            const contractions = {
                "don't": "do not", "doesn't": "does not", "didn't": "did not",
                "can't": "cannot", "won't": "will not", "it's": "it is",
                "we're": "we are", "they're": "they are", "i'm": "i am",
                "let's": "let us", "haven't": "have not", "hasn't": "has not"
            };
            const fillers = new Set(["um", "uh", "er", "ah", "like"]);
            let cleaned = (text || "").toLowerCase().replace(/[.,!?;:"()]/g, " ");
            Object.entries(contractions).forEach(([k, v]) => {
                cleaned = cleaned.replace(new RegExp(`\\b${k}\\b`, "g"), v);
            });
            return cleaned.split(/\s+/).filter(t => t && !fillers.has(t));
        }

        function runHonestSpeechCheck(idx, expectedSentence) {
            const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
            const outBox = document.getElementById(`shadow-metrics-${idx}`);
            const btn = document.getElementById(`shadow-mic-${idx}`);

            if (!SpeechRec) {
                outBox.classList.remove("hidden");
                outBox.innerHTML = `<p class="text-amber-800 font-semibold">Trình duyệt không hỗ trợ SpeechRecognition. Hãy tự đọc to câu mẫu và đối chiếu từng từ bên trên.</p>`;
                return;
            }

            const rec = new SpeechRec();
            rec.lang = "en-US";
            rec.interimResults = false;
            btn.classList.add("mic-active");

            rec.onresult = (ev) => {
                const resItem = ev.results[0][0];
                const spokenRaw = resItem.transcript || "";
                const confidenceVal = typeof resItem.confidence === "number" && resItem.confidence > 0
                    ? `${Math.round(resItem.confidence * 100)}%`
                    : "N/A";

                const expTokens = normalizeSpeechTokens(expectedSentence);
                const spkTokens = normalizeSpeechTokens(spokenRaw);
                const spkSet = new Set(spkTokens);
                const expSet = new Set(expTokens);

                const matched = expTokens.filter(t => spkSet.has(t));
                const missing = expTokens.filter(t => !spkSet.has(t));
                const extra = spkTokens.filter(t => !expSet.has(t));

                if (missing.length >= 2) {
                    logErrorToNotebook("Speaking", "Final Sounds", `Thiếu/nuốt từ khi đọc: "${missing.join(', ')}"`, expectedSentence, expectedSentence);
                }

                outBox.classList.remove("hidden");
                outBox.innerHTML = `
                    <p><strong>Transcript nhận diện:</strong> "${spokenRaw}"</p>
                    <p class="text-emerald-700"><strong>Matched words (${matched.length}/${expTokens.length}):</strong> ${matched.join(", ") || "Không có"}</p>
                    <p class="text-rose-700"><strong>Missing / Omitted words:</strong> ${missing.join(", ") || "Không thiếu từ nào"}</p>
                    <p class="text-amber-700"><strong>Extra words:</strong> ${extra.join(", ") || "Không có"}</p>
                    <p class="text-slate-500"><strong>Recognition Confidence (Độ tin cậy nhận dạng):</strong> ${confidenceVal}</p>
                `;
            };
            rec.onerror = () => showToast("Không thu được âm thanh rõ, vui lòng thử lại.");
            rec.onend = () => btn.classList.remove("mic-active");
            rec.start();
        }

