        function restoreFromCompressedToken() {
            const token = document.getElementById("compressed-token-field").value.trim();
            if (!token) return;
            try {
                const decoded = JSON.parse(decodeURIComponent(escape(atob(token))));
                if (decoded.cs) window.appState.currentSessionNumber = decoded.cs;
                if (decoded.wm) window.appState.wordMastery = { ...window.appState.wordMastery, ...decoded.wm };
                if (decoded.cq) window.appState.customQueue = decoded.cq;
                if (decoded.en) window.appState.errorNotebook = decoded.en;
                saveStateToLocal();
                window.refreshAllUI();
                closeSyncModal();
