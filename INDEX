    <!-- Firebase Cloud Sync Module -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, getDoc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'dailyspeak-master-365';
        let db = null;
        let currentUser = null;
        let unsubscribeSync = null;

        async function initCloudSync() {
            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) {
                    updateSyncBadgeUI("offline");
                    return;
                }
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                const auth = getAuth(app);
                db = getFirestore(app);

                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    const cred = await signInWithCustomToken(auth, __initial_auth_token);
                    currentUser = cred.user;
                } else {
                    const cred = await signInAnonymously(auth);
                    currentUser = cred.user;
                }
                updateSyncBadgeUI("synced");
                if (window.appState?.syncCode) {
                    attachRealtimeSyncListener(window.appState.syncCode);
                }
                if (window.appState?.routeCode) {
                    attachGroupLeaderboardListener(window.appState.routeCode);
                }
            } catch (err) {
                updateSyncBadgeUI("offline");
            }
        }

        function attachRealtimeSyncListener(syncCode) {
            if (!db || !currentUser || !syncCode) return;
            if (unsubscribeSync) unsubscribeSync();
            const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'user_sync_profiles', syncCode);
            unsubscribeSync = onSnapshot(docRef, (snap) => {
                if (snap.exists()) {
                    const remote = snap.data();
                    if (remote.updatedAt && remote.updatedAt > (window.appState.updatedAt || 0) && remote.payload) {
                        window.appState = { ...window.appState, ...remote.payload };
                        localStorage.setItem(MASTER_REGISTRY_KEY, JSON.stringify(window.registryState));
                        window.refreshAllUI();
                        updateSyncBadgeUI("synced");
                    }
                }
            }, () => updateSyncBadgeUI("offline"));
        }

        window.pushStateToFirebase = async function(manualNotify = false) {
            if (!db || !currentUser || !window.appState?.syncCode) {
                if (manualNotify) window.showToast("Đã lưu cục bộ (chế độ ngoại tuyến).");
                return;
            }
            try {
                updateSyncBadgeUI("syncing");
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'user_sync_profiles', window.appState.syncCode);
                await setDoc(docRef, {
                    syncCode: window.appState.syncCode,
                    pin: window.appState.syncPin || "",
                    updatedAt: window.appState.updatedAt || Date.now(),
                    payload: window.appState
                }, { merge: true });
                updateSyncBadgeUI("synced");
                if (manualNotify) window.showToast("Đã đồng bộ dữ liệu lên đám mây thành công!");
            } catch (e) {
                updateSyncBadgeUI("offline");
            }
        };

        function attachGroupLeaderboardListener(routeCode) {
            if (!db || !currentUser || !routeCode) return;
            const lbDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'route_leaderboards', routeCode);
            onSnapshot(lbDocRef, (snap) => {
                if (snap.exists()) {
                    const data = snap.data();
                    if (data.members) {
                        window.remoteGroupMembers = data.members;
                        if (!document.getElementById("profile-group-modal").classList.contains("hidden")) {
                            renderProfileGroupModal();
                        }
                    }
                    if (data.issuedKeys) {
                        window.registryState.issuedKeys = { ...window.registryState.issuedKeys, ...data.issuedKeys };
                        localStorage.setItem(window.LOCAL_STORAGE_KEY, JSON.stringify(window.registryState));
                    }
                    if (data.adminSecret) {
                        window.registryState.adminSecret = data.adminSecret;
                        localStorage.setItem(window.LOCAL_STORAGE_KEY, JSON.stringify(window.registryState));
                    }
                }
            }, () => {});
        }

        window.pushAdminRegistryToCloud = async function() {
            if (!db || !currentUser) return;
            try {
                const lbDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'route_leaderboards', "ADMIN_GROUP_MAIN");
                await setDoc(lbDocRef, {
                    adminSecret: window.registryState.adminSecret,
                    issuedKeys: window.registryState.issuedKeys
                }, { merge: true });
            } catch (e) {}
        };

        window.fetchLatestAdminRegistryFromCloud = async function() {
            if (!db || !currentUser) return;
            try {
                const lbDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'route_leaderboards', "ADMIN_GROUP_MAIN");
                const snap = await getDoc(lbDocRef);
                if (snap.exists()) {
                    const data = snap.data();
                    if (data.adminSecret) window.registryState.adminSecret = data.adminSecret;
                    if (data.issuedKeys) window.registryState.issuedKeys = { ...window.registryState.issuedKeys, ...data.issuedKeys };
                    localStorage.setItem(window.LOCAL_STORAGE_KEY, JSON.stringify(window.registryState));
                }
            } catch (e) {}
        };

        window.pushMemberStatsToLeaderboard = async function() {
            if (!db || !currentUser || !window.appState?.activeMemberId) return;
            try {
                const stats = computeCurrentProfileStats();
                const lbDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'route_leaderboards', "ADMIN_GROUP_MAIN");
                await setDoc(lbDocRef, {
                    members: {
                        [window.appState.activeMemberId]: stats
                    }
                }, { merge: true });
            } catch (e) {}
        };

        window.pullStateFromFirebase = async function(targetCode, pinAttempt) {
            if (!db || !currentUser) {
                window.showToast("Chế độ ngoại tuyến: đã chuyển mã định danh cục bộ.");
                attachRealtimeSyncListener(targetCode);
                return true;
            }
            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'user_sync_profiles', targetCode);
                const snap = await getDoc(docRef);
                if (snap.exists()) {
                    const data = snap.data();
                    if (data.pin && data.pin !== pinAttempt) {
                        window.showToast("Mã PIN 4 số không khớp với thiết bị gốc!");
                        return false;
                    }
                    window.appState = { ...window.appState, ...data.payload, syncCode: targetCode, syncPin: pinAttempt || data.pin || "" };
                    localStorage.setItem(MASTER_REGISTRY_KEY, JSON.stringify(window.registryState));
                    window.refreshAllUI();
                    window.showToast(`Đã tải toàn bộ tiến độ từ mã ${targetCode}!`);
                } else {
                    window.appState.syncCode = targetCode;
                    window.appState.syncPin = pinAttempt || "";
                    await window.pushStateToFirebase(true);
                }
                attachRealtimeSyncListener(targetCode);
                return true;
            } catch (e) {
                window.showToast("Không thể kết nối máy chủ đồng bộ lúc này.");
                return false;
            }
        };

        function updateSyncBadgeUI(status) {
            const dot = document.getElementById("sync-status-dot");
            const label = document.getElementById("sync-code-short");
            if (!dot || !label) return;
            if (status === "synced") {
                dot.className = "w-2 h-2 rounded-full bg-emerald-500";
                label.textContent = "Synced";
            } else if (status === "syncing") {
                dot.className = "w-2 h-2 rounded-full bg-amber-500 animate-ping";
                label.textContent = "Syncing";
            } else {
                dot.className = "w-2 h-2 rounded-full bg-slate-400";
                label.textContent = "Local";
            }
        }

        window.addEventListener("DOMContentLoaded", () => {
            initCloudSync();
        });
